# Fault 1 - a "harmless" rename of the database user in the environment values.
# The database (created on first start) still only knows the user "shelfshare".
database:
  user: shelfshare_app

$ troubleshooting/inject.sh troubleshooting/01-wrong-db-user.values.yaml && git -C ~/shelfshare-gitops show --format= HEAD | tail -n +5
