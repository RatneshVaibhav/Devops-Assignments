$ python3 - <<"PY"
import json
path = "helm/shelfshare/files/grafana-dashboard.json"
d = json.load(open(path))
for p in d["panels"]:
    if p["id"] in (3, 4):
        metric = "listed" if p["id"] == 3 else "reserved"
        p["title"] = f"Books {metric} (time range)"
        p["targets"][0]["expr"] = f"round(sum(increase(shelfshare_books_{metric}_total{{namespace=\"__NAMESPACE__\"}}[$__range])))"
d["version"] += 1
json.dump(d, open(path, "w"), indent=2); open(path, "a").write("\n")
PY
