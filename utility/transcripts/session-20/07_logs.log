$ L() { kubectl logs -n session20 -l app=campus-status --since=60s --tail=-1 | grep "^{"; }; echo "L = all JSON log lines of every replica from the last 60 s (-l alone keeps only 10 lines per pod)"
L = all JSON log lines of every replica from the last 60 s (-l alone keeps only 10 lines per pod)

$ L | jq -s -c "group_by(.status) | map({status: .[0].status, requests: length})"
[{"status":200,"requests":598},{"status":500,"requests":281}]

$ L | jq -s -c "group_by(.path) | map({path: .[0].path, requests: length, errors: (map(select(.status >= 500)) | length)})"
[{"path":"/api/flaky","requests":562,"errors":281},{"path":"/api/notices","requests":281,"errors":0},{"path":"/health","requests":12,"errors":0},{"path":"/ready","requests":24,"errors":0}]

