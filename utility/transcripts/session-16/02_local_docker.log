5f573d58af25518b8ae65f2a7110b0b40ecbeff7766a8b70131f7c9fbe34ce86

$ docker exec cgpa-local id
uid=10001(appuser) gid=10001(appuser) groups=10001(appuser)

$ curl -s http://localhost:18000/health; echo
{"build":"8ecf9cd442a0","status":"ok","version":"1.0.0"}


$ curl -s -X POST http://localhost:18000/api/sgpa -H "Content-Type: application/json" -d "{\"courses\":[{\"grade\":\"O\",\"credits\":4},{\"grade\":\"A\",\"credits\":3},{\"grade\":\"B+\",\"credits\":1}]}"; echo
{"sgpa":8.88}


$ curl -s -X POST http://localhost:18000/api/cgpa -H "Content-Type: application/json" -d "{\"semesters\":[{\"sgpa\":8.0,\"credits\":20},{\"sgpa\":9.0,\"credits\":30}]}"; echo
{"cgpa":8.6,"percentage":81.7}


$ curl -s -X POST http://localhost:18000/api/sgpa -H "Content-Type: application/json" -d "{\"courses\":[{\"grade\":\"Z\",\"credits\":4}]}"; echo
{"error":"unknown grade 'Z', expected one of O, A+, A, B+, B, C, P, F"}


