#CWD ~/Devops-Assignments/session-18-terraform-iac/aws-services/05-dynamodb-rds
$ aws dynamodb create-table --table-name Enrollments --attribute-definitions AttributeName=student_id,AttributeType=S AttributeName=course_code,AttributeType=S --key-schema AttributeName=student_id,KeyType=HASH AttributeName=course_code,KeyType=RANGE --billing-mode PAY_PER_REQUEST --query "TableDescription.[TableName,TableStatus,BillingModeSummary.BillingMode]" --output text
Enrollments	ACTIVE	PAY_PER_REQUEST

$ for row in "24bcs10413 CS301 DevOps A+" "24bcs10413 CS305 Networks O" "24bcs10413 MA201 Statistics A" "24bcs10999 CS301 DevOps B+"; do set -- $row; aws dynamodb put-item --table-name Enrollments --item "{\"student_id\":{\"S\":\"$1\"},\"course_code\":{\"S\":\"$2\"},\"course\":{\"S\":\"$3\"},\"grade\":{\"S\":\"$4\"}}"; done; echo "4 items written"
4 items written

$ aws dynamodb query --table-name Enrollments --key-condition-expression "student_id = :s" --expression-attribute-values "{\":s\":{\"S\":\"24bcs10413\"}}" --query "Items[].[course_code.S,course.S,grade.S]" --output table
-------------------------------
|            Query            |
+--------+--------------+-----+
|  CS301 |  DevOps      |  A+ |
|  CS305 |  Networks    |  O  |
|  MA201 |  Statistics  |  A  |
+--------+--------------+-----+

$ aws dynamodb query --table-name Enrollments --key-condition-expression "student_id = :s AND begins_with(course_code, :p)" --expression-attribute-values "{\":s\":{\"S\":\"24bcs10413\"},\":p\":{\"S\":\"CS\"}}" --query "Count"
2

$ aws dynamodb get-item --table-name Enrollments --key "{\"student_id\":{\"S\":\"24bcs10999\"},\"course_code\":{\"S\":\"CS301\"}}" --query "Item.grade.S" --output text
B+

$ aws rds create-db-instance --db-instance-identifier campus-db --engine postgres --engine-version 16.4 --db-instance-class db.t3.micro --allocated-storage 20 --master-username campusadmin --master-user-password "$(openssl rand -hex 16)" --storage-encrypted --backup-retention-period 7 --multi-az --query "DBInstance.[DBInstanceIdentifier,Engine,DBInstanceClass,DBInstanceStatus]" --output text
campus-db	postgres	db.t3.micro	available

$ aws rds describe-db-instances --db-instance-identifier campus-db --query "DBInstances[0].{endpoint:Endpoint.Address,port:Endpoint.Port,multiAZ:MultiAZ,encrypted:StorageEncrypted,backupDays:BackupRetentionPeriod}"
{
    "endpoint": "campus-db.aaaaaaaaaa.ap-south-1.rds.amazonaws.com",
    "port": 5432,
    "multiAZ": true,
    "encrypted": true,
    "backupDays": 7
}

$ aws rds create-db-snapshot --db-instance-identifier campus-db --db-snapshot-identifier campus-db-before-upgrade --query "DBSnapshot.[DBSnapshotIdentifier,Status]" --output text
campus-db-before-upgrade	available

$ aws rds create-db-instance-read-replica --db-instance-identifier campus-db-replica --source-db-instance-identifier campus-db --query "DBInstance.[DBInstanceIdentifier,ReadReplicaSourceDBInstanceIdentifier]" --output text
campus-db-replica	campus-db

$ aws rds describe-db-instances --query "DBInstances[].[DBInstanceIdentifier,DBInstanceStatus,MultiAZ,ReadReplicaSourceDBInstanceIdentifier]" --output table
---------------------------------------------------------
|                  DescribeDBInstances                  |
+--------------------+------------+-------+-------------+
|  campus-db         |  available |  True |  None       |
|  campus-db-replica |  available |  True |  campus-db  |
+--------------------+------------+-------+-------------+

